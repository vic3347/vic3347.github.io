    <div id="pageViewData" data-value="{&quot;DateTaxonomyTerm&quot;:[],&quot;ID&quot;:&quot;50930&quot;,&quot;Title&quot;:&quot;Census of Population and Dwellings&quot;,&quot;ClassName&quot;:&quot;BlockPage&quot;,&quot;BackgroundColor&quot;:&quot;white&quot;,&quot;FeaturedMedia&quot;:[],&quot;FeaturedText&quot;:null,&quot;IsPublishing&quot;:false,&quot;MediaPosition&quot;:&quot;&quot;,&quot;PageLayout&quot;:&quot;simple&quot;,&quot;PageLink&quot;:&quot;\/census\/&quot;,&quot;PageDate&quot;:&quot;2020-12-03 23:11:55&quot;,&quot;TagPosition&quot;:&quot;bottom&quot;,&quot;MetaDescription&quot;:&quot;In 2024, we sought public feedback on what the census could look like from 2028 and beyond.&quot;,&quot;PageBreadcrumbs&quot;:[{&quot;Title&quot;:&quot;Home&quot;,&quot;MenuTitle&quot;:&quot;Home&quot;,&quot;Link&quot;:&quot;\/&quot;},{&quot;Title&quot;:&quot;Census of Population and Dwellings&quot;,&quot;MenuTitle&quot;:&quot;Census of Population and Dwellings&quot;,&quot;Link&quot;:&quot;\/census\/&quot;}],&quot;SiteBanner&quot;:{&quot;ID&quot;:47,&quot;Title&quot;:&quot;www3.stats.govt.nz planned maintenance&quot;,&quot;BannerHeading&quot;:&quot;Planned maintenance: Monday 9 March from 5pm - 6pm &quot;,&quot;BannerType&quot;:&quot;interesting-information&quot;,&quot;Description&quot;:&quot;&lt;p&gt;During this time, the small number of files and applications that are hosted on www3.stats.govt.nz may be temporarily unavailable. The Stats NZ website will remain accessible throughout this time.&lt;\/p&gt;&quot;,&quot;ActionText&quot;:&quot;Find out more&quot;,&quot;Action&quot;:null,&quot;ActionTarget&quot;:&quot;&quot;,&quot;AllPages&quot;:1,&quot;Expires&quot;:&quot;2026-03-09 17:48:00&quot;,&quot;LastEdited&quot;:&quot;2026-03-09 17:45:40&quot;},&quot;PageBlocks&quot;:[{&quot;ID&quot;:&quot;50936&quot;,&quot;Title&quot;:&quot;Census sitetree landing page intro&quot;,&quot;ClassName&quot;:&quot;TextBlock&quot;,&quot;ShowBlockTitle&quot;:false,&quot;DefaultView&quot;:&quot;Grid&quot;,&quot;Content&quot;:&quot;&lt;p&gt;&lt;span class=\&quot;intro\&quot;&gt;The census is the official count of the people and dwellings in New Zealand.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;&quot;},{&quot;ID&quot;:&quot;39954&quot;,&quot;Title&quot;:&quot;About the census - census topic page&quot;,&quot;ClassName&quot;:&quot;TextBlock&quot;,&quot;ShowBlockTitle&quot;:false,&quot;DefaultView&quot;:&quot;Grid&quot;,&quot;Content&quot;:&quot;&lt;h2&gt;&lt;a name=\&quot;about-the-census\&quot;&gt;&lt;\/a&gt;About the census&lt;\/h2&gt;&lt;p&gt;Every five years, we run the census \u2013 the official count of how many people and dwellings there are in New Zealand. By asking everyone to complete a set of questions about themselves and their household, we can capture a snapshot of who is living in, and visiting, New Zealand.&lt;\/p&gt;&lt;p&gt;The census is the only survey in New Zealand that covers the whole population. It provides the most complete picture of life in our cities, towns, suburbs, and rural areas.&lt;\/p&gt;&lt;p&gt;The data helps the government plan services. These include hospitals, k\u014dhanga reo, schools, roads, and public transport. Councils, iwi, businesses, and other organisations also use the data to work out the needs in their area.&amp;nbsp;&lt;\/p&gt;&quot;},{&quot;ID&quot;:&quot;50933&quot;,&quot;Title&quot;:&quot;Census sitetree landing page - link to Census topic page&quot;,&quot;ClassName&quot;:&quot;TextBlock&quot;,&quot;ShowBlockTitle&quot;:false,&quot;DefaultView&quot;:&quot;Grid&quot;,&quot;Content&quot;:&quot;&lt;h2&gt;Census data and information&lt;\/h2&gt;\n&lt;p&gt;&lt;a href=\&quot;\/topics\/census\/\&quot;&gt;Census topic page&lt;\/a&gt;&amp;nbsp;provides the latest data, news, and information about the Census of Population and Dwellings&lt;span style=\&quot;font-size: 1rem;\&quot;&gt;.&lt;\/span&gt;&lt;\/p&gt;&quot;},{&quot;ID&quot;:&quot;50939&quot;,&quot;Title&quot;:&quot;Census sitetree landing page nav block&quot;,&quot;ClassName&quot;:&quot;NavigationBlockV2&quot;,&quot;ShowBlockTitle&quot;:false,&quot;DefaultView&quot;:&quot;Grid&quot;,&quot;ColorTheme&quot;:&quot;light-grey&quot;,&quot;SlotsData&quot;:[{&quot;ID&quot;:542,&quot;Title&quot;:&quot;Latest census&quot;,&quot;Description&quot;:&quot;The most recent census was held in 2023. Data from this census is now available. &quot;,&quot;LinkTitle&quot;:&quot;2023 Census&quot;,&quot;Href&quot;:&quot;\/2023-census\/&quot;,&quot;OpenInNewWindow&quot;:false},{&quot;ID&quot;:545,&quot;Title&quot;:&quot;Modernising the census&quot;,&quot;Description&quot;:&quot;Changes to modernise our census have been announced. Learn what they are, and why they are happening&quot;,&quot;LinkTitle&quot;:&quot;Modernising the census&quot;,&quot;Href&quot;:&quot;\/census\/modernising-the-census\/&quot;,&quot;OpenInNewWindow&quot;:false},{&quot;ID&quot;:548,&quot;Title&quot;:&quot;Previous censuses&quot;,&quot;Description&quot;:&quot;2018, 2013, 2006, 2001, and 1996 Censuses and digitised early censuses&quot;,&quot;LinkTitle&quot;:&quot;Previous censuses&quot;,&quot;Href&quot;:&quot;\/census\/previous-censuses\/&quot;,&quot;OpenInNewWindow&quot;:false}]},{&quot;ID&quot;:&quot;50942&quot;,&quot;Title&quot;:&quot;Census sitetree landing page - page updated&quot;,&quot;ClassName&quot;:&quot;TextBlock&quot;,&quot;ShowBlockTitle&quot;:false,&quot;DefaultView&quot;:&quot;Grid&quot;,&quot;Content&quot;:&quot;&lt;p&gt;Page updated 8 May 2024.&lt;\/p&gt;&quot;}],&quot;DefaultView&quot;:&quot;Grid&quot;,&quot;PageBlockSortOrder&quot;:{&quot;50936&quot;:1,&quot;39954&quot;:2,&quot;50933&quot;:3,&quot;50939&quot;:4,&quot;50942&quot;:5},&quot;EnableTopDivider&quot;:{&quot;50936&quot;:&quot;No&quot;,&quot;39954&quot;:&quot;No&quot;,&quot;50933&quot;:&quot;No&quot;,&quot;50939&quot;:&quot;No&quot;,&quot;50942&quot;:&quot;No&quot;},&quot;PageBlockWidths&quot;:{&quot;50936&quot;:0,&quot;39954&quot;:0,&quot;50933&quot;:0,&quot;50939&quot;:0,&quot;50942&quot;:0},&quot;PageTerms&quot;:[],&quot;PagesRelated&quot;:[],&quot;Category&quot;:{&quot;ID&quot;:0,&quot;DisplayName&quot;:&quot;&quot;,&quot;LinkData&quot;:&quot;{\&quot;LinkURL\&quot;:\&quot;\&quot;,\&quot;Title\&quot;:\&quot;\&quot;}&quot;,&quot;FilterName&quot;:null},&quot;TermsReleases&quot;:[],&quot;TermsTopics&quot;:[]}"></div> 

